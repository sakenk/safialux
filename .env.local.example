# Supabase (Settings -> API). Без этих ключей сайт работает на демо-данных, админка только читает.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary — загрузка фото из админки
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Админка
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Уведомление в Telegram о каждом новом заказе (необязательно).
# 1. Напишите @BotFather в Telegram -> /newbot -> получите TELEGRAM_BOT_TOKEN.
# 2. Напишите своему новому боту любое сообщение (иначе он не сможет писать вам первым).
# 3. Откройте https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates и возьмите
#    число из "chat":{"id": ...} — это TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SEO
NEXT_PUBLIC_SITE_URL=https://sanlux.kz
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
